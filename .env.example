# Copy to apps/web/.env.local and fill in. NEVER commit real values.
# The build fails with a readable error if a required variable is missing (apps/web/src/env.ts).

# Supabase (public: safe in the browser)
# Dashboard → Project Settings → API Keys → "Publishable key" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (SERVER ONLY: never prefix with NEXT_PUBLIC_)
# Dashboard → Project Settings → API Keys → "Secret key" (sb_secret_...)
# Optional until a feature needs it; RLS covers almost everything.
SUPABASE_SECRET_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend), server only. Optional until the app sends its own email (auth emails come from Supabase).
RESEND_API_KEY=
EMAIL_FROM="Carza <no-reply@yourdomain.com>"

# Web push (optional: no push alerts without these). Generate a pair with `npx web-push generate-vapid-keys`.
# The dispatch secret is any random 32+ character string; store the same value in Supabase Vault as
# 'push_dispatch_secret', with 'push_dispatch_url' = <site>/api/push/dispatch.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_DISPATCH_SECRET=
